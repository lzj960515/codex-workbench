<mxfile host="Agent">
  <diagram id="technical-sketch-template" name="Technical Sketch">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" background="#FFFDF5">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="技术架构草图" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=30;fontStyle=1;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="70" y="50" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="用一句话说明这张图回答什么问题" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=16;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="72" y="105" width="700" height="32" as="geometry" />
        </mxCell>
        <mxCell id="entry" value="入口" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;fillColor=#DCEBFF;strokeColor=#243142;strokeWidth=2;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=18;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="90" y="220" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="service" value="核心服务" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;fillColor=#FFF2CC;strokeColor=#243142;strokeWidth=2;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=18;fontStyle=1;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="430" y="220" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="任务队列" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;sketch=1;curveFitting=1;jiggle=2;fillColor=#DFF3E4;strokeColor=#243142;strokeWidth=2;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=18;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="790" y="210" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="Worker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;fillColor=#E9E1F7;strokeColor=#243142;strokeWidth=2;hachureGap=8;fillWeight=1.5;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=18;fontStyle=1;fontColor=#243142;" vertex="1" parent="1">
          <mxGeometry x="1140" y="220" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="entry-to-service" value="请求" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#243142;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=15;fontColor=#243142;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="entry" target="service">
          <mxGeometry x="0" y="-1" relative="1" as="geometry">
            <mxPoint x="0" y="-16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="service-to-queue" value="异步写入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#243142;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=15;fontColor=#243142;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="service" target="queue">
          <mxGeometry x="0" y="-1" relative="1" as="geometry">
            <mxPoint x="0" y="-16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="queue-to-worker" value="消费" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#243142;strokeWidth=2.5;endArrow=classic;endFill=1;endSize=18;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=15;fontColor=#243142;labelBackgroundColor=#FFFDF5;" edge="1" parent="1" source="queue" target="worker">
          <mxGeometry x="0" y="-1" relative="1" as="geometry">
            <mxPoint x="0" y="-16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="便签：在这里补充重要约束或异常路径" style="shape=note;whiteSpace=wrap;html=1;size=18;sketch=1;curveFitting=1;jiggle=2;fillColor=#FFF4D6;strokeColor=#D97736;strokeWidth=2;hachureGap=10;fillWeight=1;fontFamily=Chalkboard SE,Comic Sans MS;fontSize=16;fontColor=#7C3514;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="430" y="430" width="560" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
